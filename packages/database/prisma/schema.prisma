generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String          @map("password_hash")
  firstName         String          @map("first_name")
  lastName          String          @map("last_name")
  avatarUrl         String?         @map("avatar_url")
  phoneNumber       String?         @map("phone_number")
  status            UserStatus      @default(PENDING_VERIFICATION)
  emailVerified     DateTime?       @map("email_verified")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  teacherBatches    BatchTeacher[]
  ownedBatches      Batch[]         @relation("BatchOwner")
  learnerProfile    LearnerProfile?
  parentLinks       ParentStudent[] @relation("ParentStudentParent")
  studentLinks      ParentStudent[] @relation("ParentStudentStudent")
  authoredQuestions Question[]      @relation("QuestionAuthor")
  reviewedQuestions Question[]      @relation("QuestionReviewer")
  sessions          Session[]
  roles             UserRole[]

  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  displayName String     @map("display_name")
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LearnerProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique @map("user_id")
  currentStage        EducationalStage         @default(BASIC_EDUCATION) @map("current_stage")
  currentGradeLevel   GradeLevel?              @map("current_grade_level")
  currentProgramId    String?                  @map("current_program_id")
  currentCurriculumId String?                  @map("current_curriculum_id")
  learningGoals       String?                  @map("learning_goals")
  preferredLanguage   String                   @default("fil") @map("preferred_language")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  organizationId      String?                  @map("organization_id")
  attempts            AssessmentAttempt[]
  batchMembers        BatchMember[]
  enrollments         Enrollment[]
  currentCurriculum   Curriculum?              @relation(fields: [currentCurriculumId], references: [id])
  currentProgram      Program?                 @relation(fields: [currentProgramId], references: [id])
  organization        Organization?            @relation(fields: [organizationId], references: [id])
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonResponses     LessonQuestionResponse[]
  progressRecords     Progress[]
  questionExposures   QuestionExposure[]
  testAttempts        TestAttempt[]

  @@index([organizationId])
  @@map("learner_profiles")
}

model SiteSettings {
  id        String   @id @default("default")
  brand     Json?
  general   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            String?
  status          ContentStatus    @default(PUBLISHED)
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  assessments     Assessment[]
  curriculums     Curriculum[]
  learnerProfiles LearnerProfile[]
  programs        Program[]

  @@map("organizations")
}

model Program {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  programType     String?          @map("program_type")
  status          ProgramStatus    @default(DRAFT)
  imageUrl        String?          @map("image_url")
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organizationId  String?          @map("organization_id")
  assessments     Assessment[]
  batches         Batch[]
  curriculums     Curriculum[]
  enrollments     Enrollment[]
  learnerProfiles LearnerProfile[]
  targetCets      ProgramCet[]
  organization    Organization?    @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([organizationId])
  @@map("programs")
}

model Curriculum {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  stage           EducationalStage
  gradeLevel      GradeLevel?
  orderIndex      Int              @default(0) @map("order_index")
  status          ContentStatus    @default(DRAFT)
  programId       String?          @map("program_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organizationId  String?          @map("organization_id")
  items           CurriculumItem[]
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  program         Program?         @relation(fields: [programId], references: [id])
  learnerProfiles LearnerProfile[]

  @@index([stage, gradeLevel])
  @@index([programId])
  @@index([organizationId])
  @@map("curriculums")
}

model CurriculumItem {
  id           String     @id @default(cuid())
  curriculumId String     @map("curriculum_id")
  subjectId    String     @map("subject_id")
  orderIndex   Int        @default(0) @map("order_index")
  isRequired   Boolean    @default(true) @map("is_required")
  customName   String?    @map("custom_name")
  createdAt    DateTime   @default(now()) @map("created_at")
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, subjectId])
  @@index([curriculumId])
  @@index([subjectId])
  @@map("curriculum_items")
}

model Subject {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  code            String?            @unique
  description     String?
  icon            String?
  color           String?
  status          ContentStatus      @default(DRAFT)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  curriculumItems CurriculumItem[]
  examCoverages   ExamCoverage[]
  modules         Module[]
  questions       QuestionBankLink[]
  cetProfiles     CetProfile[]       @relation("CetProfileToSubject")

  @@map("subjects")
}

model Module {
  id          String        @id @default(cuid())
  subjectId   String        @map("subject_id")
  name        String
  slug        String        @unique
  description String?
  orderIndex  Int           @default(0) @map("order_index")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@index([subjectId])
  @@map("modules")
}

model Topic {
  id          String             @id @default(cuid())
  moduleId    String             @map("module_id")
  name        String
  slug        String             @unique
  description String?
  orderIndex  Int                @default(0) @map("order_index")
  status      ContentStatus      @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  lessons     Lesson[]
  progress    Progress[]
  questions   QuestionBankLink[]
  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("topics")
}

model Lesson {
  id              String        @id @default(cuid())
  topicId         String        @map("topic_id")
  title           String
  slug            String        @unique
  description     String?
  type            LessonType    @default(ARTICLE)
  durationMinutes Int?          @map("duration_minutes")
  content         Json?
  videoUrl        String?       @map("video_url")
  orderIndex      Int           @default(0) @map("order_index")
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress        Progress[]

  @@index([topicId])
  @@map("lessons")
}

model Passage {
  id        String             @id @default(cuid())
  title     String
  content   String
  sourceUrl String?            @map("source_url")
  status    ContentStatus      @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  bankLinks QuestionBankLink[]
  questions Question[]

  @@map("passages")
}

model Question {
  id                  String                   @id @default(cuid())
  type                QuestionType
  difficulty          DifficultyLevel          @default(MEDIUM)
  stem                String
  options             Json?
  correctAnswer       Json
  explanation         String?
  hint                String?
  tags                String[]
  mediaUrl            String?                  @map("media_url")
  status              ContentStatus            @default(DRAFT)
  authorId            String                   @map("author_id")
  reviewerId          String?                  @map("reviewer_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  passageId           String?                  @map("passage_id")
  assessmentQuestions AssessmentQuestion[]
  attemptAnswers      AttemptAnswer[]
  lessonResponses     LessonQuestionResponse[]
  bankLinks           QuestionBankLink[]
  exposures           QuestionExposure[]
  author              User                     @relation("QuestionAuthor", fields: [authorId], references: [id])
  passage             Passage?                 @relation(fields: [passageId], references: [id])
  reviewer            User?                    @relation("QuestionReviewer", fields: [reviewerId], references: [id])

  @@index([difficulty])
  @@index([status])
  @@index([type])
  @@index([passageId])
  @@map("questions")
}

model QuestionBankLink {
  id           String      @id @default(cuid())
  questionId   String      @map("question_id")
  subjectId    String?     @map("subject_id")
  topicId      String?     @map("topic_id")
  examId       String?     @map("exam_id")
  assessmentId String?     @map("assessment_id")
  weight       Int         @default(1)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  passageId    String?     @map("passage_id")
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  cetExam      CetExam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  passage      Passage?    @relation(fields: [passageId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        Topic?      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([subjectId])
  @@index([topicId])
  @@index([examId])
  @@index([assessmentId])
  @@index([passageId])
  @@map("question_bank_links")
}

model CetExam {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  description    String?
  examType       ExamType
  conductingBody String?            @map("conducting_body")
  website        String?
  status         ContentStatus      @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  profiles       CetProfile[]
  programTargets ProgramCet[]
  questionLinks  QuestionBankLink[]

  @@map("cet_exams")
}

model CetProfile {
  id                     String         @id @default(cuid())
  cetExamId              String         @map("cet_exam_id")
  name                   String
  description            String?
  subjectDistribution    Json?          @map("subject_distribution")
  totalQuestions         Int?           @map("total_questions")
  timeLimitMinutes       Int?           @map("time_limit_minutes")
  passingScore           Int?           @map("passing_score")
  difficultyDistribution Json?          @map("difficulty_distribution")
  status                 ContentStatus  @default(DRAFT)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  cetExam                CetExam        @relation(fields: [cetExamId], references: [id], onDelete: Cascade)
  coverages              ExamCoverage[]
  subjects               Subject[]      @relation("CetProfileToSubject")

  @@index([cetExamId])
  @@map("cet_profiles")
}

model ExamCoverage {
  id            String     @id @default(cuid())
  cetProfileId  String     @map("cet_profile_id")
  subjectId     String     @map("subject_id")
  percentage    Float      @default(0)
  questionCount Int?       @map("question_count")
  topicCoverage Json?      @map("topic_coverage")
  createdAt     DateTime   @default(now()) @map("created_at")
  cetProfile    CetProfile @relation(fields: [cetProfileId], references: [id], onDelete: Cascade)
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([cetProfileId, subjectId])
  @@index([cetProfileId])
  @@index([subjectId])
  @@map("exam_coverages")
}

model ProgramCet {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  cetExamId String   @map("cet_exam_id")
  priority  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  cetExam   CetExam  @relation(fields: [cetExamId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, cetExamId])
  @@index([programId])
  @@index([cetExamId])
  @@map("program_cets")
}

model Assessment {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  description        String?
  type               AssessmentType       @default(QUIZ)
  topicIds           String[]             @map("topic_ids")
  difficultyLevels   DifficultyLevel[]    @map("difficulty_levels")
  questionTags       String[]             @map("question_tags")
  questionCount      Int?                 @map("question_count")
  timeLimitMinutes   Int?                 @map("time_limit_minutes")
  passingScore       Int?                 @map("passing_score")
  randomizeQuestions Boolean              @default(false) @map("randomize_questions")
  showExplanations   Boolean              @default(true) @map("show_explanations")
  allowRetake        Boolean              @default(false) @map("allow_retake")
  maxAttempts        Int?                 @default(1) @map("max_attempts")
  scoringConfig      Json?                @map("scoring_config")
  status             ContentStatus        @default(DRAFT)
  programId          String?              @map("program_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  masteryThreshold   Int?                 @map("mastery_threshold")
  organizationId     String?              @map("organization_id")
  randomizeChoices   Boolean              @default(false) @map("randomize_choices")
  attempts           AssessmentAttempt[]
  questions          AssessmentQuestion[]
  organization       Organization?        @relation(fields: [organizationId], references: [id])
  program            Program?             @relation(fields: [programId], references: [id])
  questionLinks      QuestionBankLink[]

  @@index([programId])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String     @map("assessment_id")
  questionId   String     @map("question_id")
  orderIndex   Int        @default(0) @map("order_index")
  score        Int        @default(1)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id               String          @id @default(cuid())
  learnerId        String          @map("learner_id")
  assessmentId     String          @map("assessment_id")
  status           AttemptStatus   @default(IN_PROGRESS)
  startedAt        DateTime        @default(now()) @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  score            Int?
  maxScore         Int             @map("max_score")
  percentage       Float?
  timeSpentSeconds Int?            @map("time_spent_seconds")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  assessment       Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner          LearnerProfile  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  answers          AttemptAnswer[]

  @@index([learnerId])
  @@index([assessmentId])
  @@map("assessment_attempts")
}

model AttemptAnswer {
  id               String            @id @default(cuid())
  attemptId        String            @map("attempt_id")
  questionId       String            @map("question_id")
  answer           Json
  isCorrect        Boolean?          @map("is_correct")
  score            Int               @default(0)
  timeSpentSeconds Int?              @map("time_spent_seconds")
  createdAt        DateTime          @default(now()) @map("created_at")
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("attempt_answers")
}

model QuestionExposure {
  id         String         @id @default(cuid())
  questionId String         @map("question_id")
  learnerId  String         @map("learner_id")
  seenCount  Int            @default(1) @map("seen_count")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  learner    LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, learnerId])
  @@index([learnerId])
  @@map("question_exposures")
}

model Progress {
  id                   String         @id @default(cuid())
  learnerId            String         @map("learner_id")
  programId            String?        @map("program_id")
  curriculumId         String?        @map("curriculum_id")
  subjectId            String?        @map("subject_id")
  moduleId             String?        @map("module_id")
  topicId              String?        @map("topic_id")
  lessonId             String?        @map("lesson_id")
  mastery              MasteryLevel   @default(NOT_STARTED)
  completionPercentage Float          @default(0) @map("completion_percentage")
  averageScore         Float?         @map("average_score")
  attemptsCount        Int            @default(0) @map("attempts_count")
  lastActivityAt       DateTime       @default(now()) @map("last_activity_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  learner              LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson               Lesson?        @relation(fields: [lessonId], references: [id])
  topic                Topic?         @relation(fields: [topicId], references: [id])

  @@unique([learnerId, programId, curriculumId, subjectId, moduleId, topicId, lessonId])
  @@index([learnerId])
  @@index([topicId])
  @@index([lessonId])
  @@map("progress")
}

model LessonQuestionResponse {
  id           String         @id @default(cuid())
  learnerId    String         @map("learner_id")
  lessonId     String         @map("lesson_id")
  questionId   String         @map("question_id")
  blockId      String?        @map("block_id")
  answer       Json?
  isCorrect    Boolean?       @map("is_correct")
  pointsEarned Int            @default(0) @map("points_earned")
  attemptedAt  DateTime       @default(now()) @map("attempted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  learner      LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId, questionId])
  @@index([learnerId, lessonId, questionId])
  @@index([learnerId, blockId])
  @@map("lesson_question_responses")
}

model ProgramSubject {
  id         String   @id @default(cuid())
  programId  String   @map("program_id")
  subjectId  String   @map("subject_id")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([programId, subjectId])
  @@map("program_subjects")
}

model Test {
  id                 String         @id @default(cuid())
  programId          String?        @map("program_id")
  subjectId          String?        @map("subject_id")
  name               String
  description        String?
  type               TestType
  timeLimitMinutes   Int?           @map("time_limit_minutes")
  passingScore       Int?           @map("passing_score")
  randomizeQuestions Boolean        @default(false) @map("randomize_questions")
  showExplanation    Boolean        @default(true) @map("show_explanation")
  config             Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  attempts           TestAttempt[]
  testQuestions      TestQuestion[]

  @@index([programId])
  @@index([subjectId])
  @@map("tests")
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String @map("test_id")
  questionId String @map("question_id")
  orderIndex Int    @default(0) @map("order_index")
  score      Int    @default(1)
  test       Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
  @@map("test_questions")
}

model TestAttempt {
  id               String         @id @default(cuid())
  learnerId        String         @map("learner_id")
  testId           String         @map("test_id")
  status           AttemptStatus  @default(IN_PROGRESS)
  startedAt        DateTime       @default(now()) @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  score            Int?
  maxScore         Int            @map("max_score")
  percentage       Float?
  timeSpentSeconds Int?           @map("time_spent_seconds")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  learner          LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  test             Test           @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([testId])
  @@map("test_attempts")
}

model Enrollment {
  id           String           @id @default(cuid())
  learnerId    String           @map("learner_id")
  programId    String           @map("program_id")
  curriculumId String?          @map("curriculum_id")
  status       EnrollmentStatus @default(ACTIVE)
  startedAt    DateTime         @default(now()) @map("started_at")
  endedAt      DateTime?        @map("ended_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  learner      LearnerProfile   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  program      Program          @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([learnerId, programId])
  @@index([learnerId])
  @@map("enrollments")
}

model Batch {
  id          String         @id @default(cuid())
  programId   String         @map("program_id")
  name        String
  description String?
  ownerId     String         @map("owner_id")
  startDate   DateTime       @map("start_date")
  endDate     DateTime       @map("end_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  members     BatchMember[]
  teachers    BatchTeacher[]
  owner       User           @relation("BatchOwner", fields: [ownerId], references: [id])
  program     Program        @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("batches")
}

model BatchMember {
  id        String         @id @default(cuid())
  batchId   String         @map("batch_id")
  learnerId String         @map("learner_id")
  joinedAt  DateTime       @default(now()) @map("joined_at")
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  learner   LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([batchId, learnerId])
  @@index([batchId])
  @@map("batch_members")
}

model BatchTeacher {
  id         String   @id @default(cuid())
  batchId    String   @map("batch_id")
  teacherId  String   @map("teacher_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId])
  @@index([batchId])
  @@map("batch_teachers")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  planName  String             @map("plan_name")
  status    SubscriptionStatus @default(PENDING)
  startedAt DateTime           @default(now()) @map("started_at")
  endedAt   DateTime?          @map("ended_at")
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("PHP")
  status        String
  provider      String
  providerRefId String?  @map("provider_ref_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payments")
}

model ParentStudent {
  id            String              @id @default(cuid())
  parentUserId  String              @map("parent_user_id")
  studentUserId String              @map("student_user_id")
  status        ParentStudentStatus @default(PENDING)
  requestedBy   LinkInitiator       @default(PARENT) @map("requested_by")
  message       String?
  respondedAt   DateTime?           @map("responded_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  parent        User                @relation("ParentStudentParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  student       User                @relation("ParentStudentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentUserId])
  @@index([parentUserId])
  @@index([studentUserId])
  @@index([status])
  @@map("parent_students")
}

