{
  "name": "@aratc/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=./prisma/schema.prisma",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:seed": "npx dotenv-cli tsx src/seed.ts",
    "db:seed-rbac": "npx dotenv-cli tsx src/seed-rbac.ts",
    "demo:seed": "npx dotenv-cli tsx src/seed-demo.ts",
    "demo:verify": "npx dotenv-cli tsx src/verify-demo.ts",
    "db:reset-passwords": "npx dotenv-cli tsx src/reset-passwords.ts",
    "db:fix-org-data": "npx dotenv-cli tsx src/fix-stray-org.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=./prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aratc/shared": "workspace:*",
    "@prisma/client": "^5.19.0"
  },
  "devDependencies": {
    "@aratc/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
