# Database
DATABASE_URL="postgresql://aratc:aratc_dev_password@localhost:5432/aratc_lms?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_SECRET="change-this-to-a-secure-random-string-in-production"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# File Storage (optional for local dev)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
# CLOUDFLARE_R2_ENDPOINT=

# Demo accounts (local-only, see packages/database/src/seed-demo.ts).
# Password used by ALL demo.* accounts created by `pnpm --filter @aratc/database demo:seed`.
# Falls back to the project's documented local seed password when unset.
DEMO_PASSWORD="Test@1234"

# MinerU (optional 3rd import workflow — high-fidelity local PDF parsing:
# layout-aware Markdown, OCR for scanned pages, tables → HTML,
# formulas → LaTeX, figure extraction with captions).
# Disabled by default — the Smart and Budget workflows work without it.
# MINERU_ENABLED="true"
# Self-hosted HTTP service (recommended): pip install "mineru[core]" && mineru-api
# MINERU_API_URL="http://localhost:8000"
# Or local CLI fallback (executable name; `-p <input> -o <output>` is appended)
# MINERU_CLI_CMD="mineru"
# Max time (ms) to wait for a MinerU parse
# MINERU_TIMEOUT_MS=300000

# --- CS#24 deployment hardening ---
# Comma-separated allowlist of browser origins allowed to call the API (empty = allow all; dev only)
CORS_ORIGINS=http://localhost:8000
# Strong secrets (32+ chars). Dev fallbacks exist; production refuses to start without these.
JWT_SECRET=
SESSION_SECRET=
# Gemini API key for AI question import (no longer hardcoded in source)
GEMINI_API_KEY=
