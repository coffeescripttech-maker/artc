# Database
DATABASE_URL="postgresql://aratc:aratc_dev_password@localhost:5432/aratc_lms?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_SECRET="change-this-to-a-secure-random-string-in-production"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# File Storage (optional for local dev)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
# CLOUDFLARE_R2_ENDPOINT=

# MinerU (optional 3rd import workflow — high-fidelity local PDF parsing:
# layout-aware Markdown, OCR for scanned pages, tables → HTML,
# formulas → LaTeX, figure extraction with captions).
# Disabled by default — the Smart and Budget workflows work without it.
# MINERU_ENABLED="true"
# Self-hosted HTTP service (recommended): pip install "mineru[core]" && mineru-api
# MINERU_API_URL="http://localhost:8000"
# Or local CLI fallback (executable name; `-p <input> -o <output>` is appended)
# MINERU_CLI_CMD="mineru"
# Max time (ms) to wait for a MinerU parse
# MINERU_TIMEOUT_MS=300000
